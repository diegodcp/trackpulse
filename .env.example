# TrackPulse local defaults
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.
# NEVER store real credentials in this file.

# ── Infra (Docker Compose) ─────────────────────────────────────────────────────
POSTGRES_DB=trackpulse
POSTGRES_USER=trackpulse
POSTGRES_PASSWORD=trackpulse
POSTGRES_PORT=5432
REDIS_PORT=6379
REDPANDA_BROKER_PORT=9092
REDPANDA_ADMIN_PORT=9644

# ── Backend API ────────────────────────────────────────────────────────────────
# Mode: fixture (no auth), historical (no auth), or live (requires credentials).
TRACKPULSE_OPENF1_MODE=fixture

# Path to golden fixture directory used in fixture mode.
# Default points to examples/fixtures/bahrain-2023-race/golden which is safe to commit.
# TRACKPULSE_OPENF1_FIXTURE_DATA_DIR=examples/fixtures/bahrain-2023-race/golden

# Base URL for the public OpenF1 REST API (no auth required for historical data).
TRACKPULSE_OPENF1_BASE_URL=https://api.openf1.org

# OpenF1 authenticated live-stream credentials — only needed in live mode.
# Leave blank for fixture/historical mode.
# DO NOT set these to real values in this file.
TRACKPULSE_OPENF1_BEARER_TOKEN=<not-required-for-fixture-mode>
TRACKPULSE_OPENF1_USERNAME=<not-required-for-fixture-mode>
TRACKPULSE_OPENF1_PASSWORD=<not-required-for-fixture-mode>

# Database (disabled by default; only needed for raw event storage).
TRACKPULSE_DB_ENABLED=false
TRACKPULSE_DB_URL=postgresql+asyncpg://trackpulse:trackpulse@localhost:5432/trackpulse

# CORS origins for local development.
TRACKPULSE_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Replay producer mode: memory (default for tests) or kafka.
TRACKPULSE_REPLAY_PRODUCER_MODE=memory
TRACKPULSE_REPLAY_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
